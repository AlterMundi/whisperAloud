[Desktop Entry]
Type=Application
Name=WhisperAloud Daemon
GenericName=Voice Transcription Daemon
Comment=Start WhisperAloud background service at login
Exec=sh -lc 'command -v systemctl >/dev/null 2>&1 && systemctl --user status >/dev/null 2>&1 && exec systemctl --user start whisper-aloud.service; exec whisper-aloud --daemon'
Icon=audio-input-microphone-symbolic
X-GNOME-Autostart-enabled=true
X-GNOME-Autostart-Delay=3
NoDisplay=true
StartupNotify=false
