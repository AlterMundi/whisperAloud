[Desktop Entry]
Type=Application
Name=WhisperAloud Daemon
GenericName=Voice Transcription Daemon
Comment=Start WhisperAloud background service at login
Exec=sh -lc 'if command -v systemctl >/dev/null 2>&1 && systemctl --user cat whisper-aloud.service >/dev/null 2>&1; then systemctl --user start whisper-aloud.service && exit 0; fi; exec whisper-aloud --daemon'
Icon=audio-input-microphone-symbolic
X-GNOME-Autostart-enabled=true
X-GNOME-Autostart-Delay=3
NoDisplay=true
StartupNotify=false
